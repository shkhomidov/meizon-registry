# Local runtime state — CONTAINS SECRETS (encryption key, password pepper,
# cookie secret, database password) and logs. Never commit.
.run/
.env
*.log

# Build output
bin/
dist/
apps/registry/dist/
node_modules/

# The console bundle is generated by the Docker build; only the committed
# placeholder in pkg/server/console/dist/index.html belongs in git.
#
# `dist/` above matches a directory of that name at any depth, and git will not
# look inside an excluded directory — so the placeholder must be rescued by
# re-including the directory first, then excluding the generated bundle within
# it. Without this, `go:embed all:dist` finds no files and `go build ./...`
# fails on a fresh clone.
!pkg/server/console/dist/
pkg/server/console/dist/assets/

# Local scratch
synced-frameworks/
*.mzfw.json
/tmp/

# Test fixtures generated locally
mixed.pdf
scan.pdf
textdoc.pdf

# OS / editor
.DS_Store
.idea/
.vscode/

# Per-developer local settings
.claude/settings.local.json
