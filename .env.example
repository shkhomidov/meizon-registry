# Meizon Framework Registry — example environment
# Copy to .env and adjust. The registryd-bootstrap binary renders these into a
# YAML config that registryd loads via -cfg-file. registryctl reads the same
# REGISTRYD_* variables directly.

# --- Required secrets ---
# 32 bytes, base64-encoded (openssl rand -base64 32). Encrypts signing-key
# private material at rest. Never rotate without a migration plan.
REGISTRYD_ENCRYPTION_KEY=

# >= 32 bytes. Server-side pepper mixed into password hashes.
REGISTRYD_AUTH_PASSWORD_PEPPER=

# Reserved for the console session cookie (HMAC-SHA256). Optional in this build.
REGISTRYD_AUTH_COOKIE_SECRET=

# Secret references: any value may be file:///path/to/secret to read from a file.

# --- Governance ---
# Comma-separated emails permitted to hold the superadmin role (env allowlist).
REGISTRYD_SUPER_ADMINS=root@example.com
# Static bearer token for the read-only /api/admin/v1 surface (empty = disabled).
REGISTRYD_ADMIN_TOKEN=

# --- Database ---
REGISTRYD_PG_ADDR=localhost:5432
REGISTRYD_PG_USERNAME=registryd
REGISTRYD_PG_PASSWORD=registryd
REGISTRYD_PG_DATABASE=registryd

# --- HTTP ---
REGISTRYD_API_ADDR=localhost:8080
REGISTRYD_METRICS_ADDR=localhost:8081
REGISTRYD_API_RATE_LIMIT_RPM=600
REGISTRYD_API_RATE_LIMIT_BURST=60
REGISTRYD_BASE_URL=http://localhost:8080
